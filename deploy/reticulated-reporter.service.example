[Unit]
Description=Reticulated read-only RNS reporter
After=network-online.target rnsd.service
Wants=network-online.target

[Service]
Type=simple
User=tim
WorkingDirectory=/home/tim/python_repos/reticulated
EnvironmentFile=/etc/reticulated/reporter.env
ExecStart=/home/tim/python_repos/reticulated/.venv/bin/python -m sim.reporter --rns-destination REPLACE_WITH_PATROON_INGEST_HASH --identity /var/lib/reticulated/reporter.identity --id fedora-laptop --label "Fedora laptop" --rnstatus /home/tim/.local/bin/rnstatus --rnpath /home/tim/.local/bin/rnpath
Restart=on-failure
RestartSec=10
UMask=0077
StateDirectory=reticulated

[Install]
WantedBy=multi-user.target
