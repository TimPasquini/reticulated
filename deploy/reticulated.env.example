# Install as /etc/reticulated/reticulated.env with mode 0600.
LIVE_RNS_REPORTER_ID=patroon
LIVE_RNS_LABEL=Patroon
LIVE_RNS_RNSTATUS=/home/tim/.local/bin/rnstatus
LIVE_RNS_RNPATH=/home/tim/.local/bin/rnpath
LIVE_RNS_PATH_INTERVAL=10
LIVE_RNS_RMAP_INTERVAL=60
LIVE_REPORT_STALE_AFTER=90
LIVE_REPORT_CACHE_FILE=/var/lib/reticulated/live-reports.json.gz
LIVE_REPORT_CACHE_INTERVAL=300
LIVE_LAYOUTS_FILE=/var/lib/reticulated/live-layouts.json
LIVE_ANNOUNCE_CAPTURE_ENABLED=true
LIVE_ANNOUNCE_MAX_EVENTS=2048
LIVE_ANNOUNCE_GRAPH_MAX_DESTINATIONS=250
LIVE_ANNOUNCE_APP_DATA_PREVIEW=512
LIVE_ANNOUNCE_DB_FILE=/var/lib/reticulated/announces.sqlite3

# Native Reticulum report listener. The identity is created on first start.
LIVE_RNS_INGEST_ENABLED=true
LIVE_RNS_INGEST_IDENTITY=/var/lib/reticulated/topology-ingest.identity
LIVE_RNS_INGEST_ALLOWLIST=/etc/reticulated/reporters.json
LIVE_RNS_INGEST_ANNOUNCE_INTERVAL=300

# Optional HTTP compatibility/debug ingestion. Native RNS does not use this.
# RETICULATED_REPORT_TOKEN=replace-with-a-long-random-token
